@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
hide circle

package core {
  abstract class Fuel {
    # massKg : double
    # enrichment : double
    + Fuel(massKg:double, enrichment:double)
    + {abstract} GetThermalPower() : double
  }
  
  class UraniumFuel {
    - uraniumType : string
    + GetThermalPower() : double
  }
  
  class MOXFuel {
    - plutoniumShare : double
    + GetThermalPower() : double
  }
  
  class FuelRod {
    - fuel : Fuel
    - temperature : double
    + FuelRod(fuel:Fuel)
    + Heat(flux:double) : void
    + GetTemperature() : double
  }
  
  class ControlRod {
    - insertionLevel : double
    + Insert(level:double) : void
    + GetInsertionLevel() : double
  }
  
  class Moderator {
    - type : ModeratorType
    + Moderate(neutronFlux:double) : double
  }
  
  class ReactorCore {
    - fuelRods : List<FuelRod>
    - controlRods : List<ControlRod>
    + ReactorCore(fuelRodCount:int)
    + GetTotalPower() : double
    + Scram() : void
  }
  
  class Reactor {
    - core : ReactorCore
    - moderator : Moderator
    - state : ReactorState
    + Reactor(core:ReactorCore, moderator:Moderator)
    + Start() : void
    + Stop() : void
    + GetReactorState() : ReactorState
    + GetPowerOutput() : double
  }
  
  enum ReactorState {
    STOPPED
    RUNNING
    EMERGENCY
  }
  
  enum ModeratorType {
    WATER
    GRAPHITE
    HEAVY_WATER
  }
  
  ' note '
  note right of Fuel
    GetThermalPower() is polymorphic
    because Uranium and MOX react
    differently
  endnote
  
  note right of Reactor
    Reactor cannot be without ReactorCore, but FuelRod
    and ControlRod can be changed inside ReactorCore
  endnote
}

package control {
  abstract class Sensor {
    # alarmThreshold : double
    # monitoredCore : ReactorCore
    # measuredValue : double
    + {abstract} Measure() : double
    + IsThresholdExceeded() : bool
  }
  
  class TemperatureSensor {
    - unit : string
    + Measure() : double
  }
  
  class PressureSensor {
    - maxPressureBar : double
    + Measure() : double
  }
  
  class RadiationSensor {
    - calibrationFactor : double
    + Measure() : double
  }
  
  class ControlRoom {
    - coolingSystems : List<ICoolingSystem>
    - sensors : List<Sensor>
    - operators : List<Operator>
    - alarm : Alarm
    - reactor : Reactor
    + MonitorSensors() : void
    + RaiseAlarm(level:AlarmLevel) : void
    + GetOperatorOnDuty() : Operator
    + ActivateCooling(amount:double) : double
  }
  
  class Operator {
    # name : string
    # clearanceLevel : int
    + AnswerAlarm(alarm:Alarm) : void
    + InitiateScram(reactorCore:ReactorCore) : void
  }
  
  class Alarm {
    - level : AlarmLevel
    # alarmCode : int
    + Trigger(level:AlarmLevel) : void
    + Silence() : void
  }
  
  enum AlarmLevel {
    LOW
    MEDIUM
    HIGH
  }
  
  ' notes '
  note left of ControlRoom
    Sensors are aggregated, because they
    physically belong to Reactor, and
    ControlRoom only reads their measuredValue
  endnote
}

package cooling {
  interface ICoolingSystem {
    + RemoveHeat(core:ReactorCore, amount:double) : double
  }
  
  class PrimaryLoop {
    - pumps : List<Pump>
    - coolantTemperature : double
    # flowRate : double
    + RemoveHeat(core:ReactorCore, amount:double) : double
  }
  
  class EmergencyCoolingSystem {
    - waterReserveLiters : double
    - pumps : List<Pump>
    # isActive : bool
    + Activate(core:ReactorCore) : bool
    + RemoveHeat(core:ReactorCore, amount:double) : double
  }
  
  class Pump {
    - powerKw : double
    # isRunning : bool
    + Start() : void
    + Stop() : void
    + SetFlowRate(rate:double) : void
  }
  
  class SteamGenerator {
    - secondaryLoop : SecondaryLoop
    # steamPressure : double
    + TransferHeat(primary:PrimaryLoop) : double
  }
  
  class SecondaryLoop {
    # steamTemperature : double
    + GetSteam() : double
  }
  
  ' notes '
  note right of Pump
    Pump is different in PrimaryLoop, EmergencyCoolingSystem
    and in Condenser
  endnote
}

package power {
  class Turbine {
    - condenser : Condenser
    - rotationSpeedRpm : double
    # maxSteamPressure : double
    + Spin(secondaryLoop:SecondaryLoop) : double
  }
  
  class Generator {
    - ratedPowerMw : double
    - turbine : Turbine
    - transformer : Transformer
    + GenerateElectricity() : double
  }
  
  class Transformer {
    - grid : PowerGrid
    - inputVoltageKv : double
    - outputVoltageKv : double
    + ConvertEnergy(powerMw:double) : double
  }
  
  class PowerGrid {
    - demandMw : double
    - currentLoadMw : double
    + GetDemand() : double
    + Receive(powerMw:double) : double
  }
  
  class Condenser {
    - pumps : List<Pump>
    - coolingWaterTemperature : double
    + Condense(steamVolume:double) : double
  }
}

package safety {
  interface ISafetySystem {
    + Activate(core:ReactorCore) : bool
  }
  
  class ScramSystem {
    - responseTimeMs : int
    - isArmed : bool
    + Activate(core:ReactorCore) : bool
    + Arm() : void
  }
  
  class ContainmentBuilding {
    - wallThicknessM : double
    - internalPressure : double
    + GetPressure() : double
    + Activate(core:ReactorCore) : bool
  }
}

' relations in package core
Fuel <|-- UraniumFuel
Fuel <|-- MOXFuel
FuelRod --> "1" Fuel
ReactorCore o-- "100..300" FuelRod
ReactorCore o-- "50..100" ControlRod
Moderator --> ModeratorType
Reactor o-- "1" Moderator
Reactor *-- "1" ReactorCore
Reactor --> ReactorState

' relations in package control
Sensor <|-- TemperatureSensor
Sensor <|-- PressureSensor
Sensor <|-- RadiationSensor
Sensor --> ReactorCore
ControlRoom o-- "1..*" Operator
ControlRoom o-- "10..100" Sensor
ControlRoom o-- "1" Alarm
ControlRoom --> Reactor
ControlRoom o-- "1..*" ICoolingSystem
Operator ..> Alarm
Operator ..> ReactorCore
Alarm --> AlarmLevel

' relations in package cooling
ICoolingSystem <|.. PrimaryLoop
ICoolingSystem <|.. EmergencyCoolingSystem
ICoolingSystem ..> ReactorCore
PrimaryLoop *-- "2..4" Pump
EmergencyCoolingSystem *-- "2..4" Pump
SteamGenerator ..> PrimaryLoop
SteamGenerator --> "1" SecondaryLoop

' relations in package power
Turbine ..> SecondaryLoop
Turbine --> Condenser
Generator --> Turbine
Generator --> Transformer
Transformer --> PowerGrid
Condenser *-- "2..4" Pump

' relations in package safety
ISafetySystem <|.. ScramSystem
ISafetySystem <|.. ContainmentBuilding
ISafetySystem <|.. EmergencyCoolingSystem

@enduml