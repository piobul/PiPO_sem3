@startuml
skinparam classAttributeIconSize 0
skinparam nodesep 20
skinparam ranksep 30
skinparam linetype ortho
hide empty members
hide circle

package core {
  abstract class Fuel {
    # massKg : double
    # enrichment : double
    + Fuel(massKg:double, enrichment:double)
    + {abstract} GetThermalPower() : double
  }
  
  class UraniumFuel {
    - uraniumType : string
    + GetThermalPower() : double
  }
  
  class MOXFuel {
    - plutoniumShare : double
    + GetThermalPower() : double
  }
  
  class FuelRod {
    - fuel : Fuel
    - temperature : double
    + FuelRod(fuel:Fuel)
    + Heat(flux:double) : void
    + GetTemperature() : double
  }
  
  class ControlRod {
    - insertionLevel : double
    + Insert(level:double) : void
    + GetInsertionLevel() : double
  }
  
  class Moderator {
    - type : ModeratorType
    + Moderate(neutronFlux:double) : double
  }
  
  class ReactorCore {
    - fuelRods : List<FuelRod>
    - controlRods : List<ControlRod>
    + ReactorCore(fuelRodCount:int)
    + GetTotalPower() : double
    + Scram() : void
    + UnloadSpentRods() : List<RadioactiveWaste>
  }
  
  class Reactor {
    - core : ReactorCore
    - moderator : Moderator
    - state : ReactorState
    + Reactor(core:ReactorCore, moderator:Moderator)
    + Start() : void
    + Stop() : void
    + GetReactorState() : ReactorState
    + GetPowerOutput() : double
    + GetCore() : ReactorCore
  }
  
  enum ReactorState {
    STOPPED
    RUNNING
    EMERGENCY
  }
  
  enum ModeratorType {
    WATER
    GRAPHITE
    HEAVY_WATER
  }
  
  ' note '
  note right of Fuel
    GetThermalPower() is polymorphic
    because Uranium and MOX react
    differently
  endnote
  
  note as ReactorNote
    Reactor cannot be without ReactorCore, but FuelRod
    and ControlRod can be changed inside ReactorCore
  endnote
}

package control {
  abstract class Sensor {
    # alarmThreshold : double
    # monitoredCore : ReactorCore
    # measuredValue : double
    + {abstract} Measure() : double
    + IsThresholdExceeded() : bool
  }
  
  class TemperatureSensor {
    - unit : string
    + Measure() : double
  }
  
  class PressureSensor {
    - maxPressureBar : double
    + Measure() : double
  }
  
  class RadiationSensor {
    - calibrationFactor : double
    + Measure() : double
  }
  
  class ControlRoom {
    - coolingSystems : List<ICoolingSystem>
    - safetySystems : List<ISafetySystem>
    - sensors : List<Sensor>
    - operators : List<Operator>
    - alarm : Alarm
    - reactor : Reactor
    + MonitorSensors() : void
    + RaiseAlarm(level:AlarmLevel) : void
    + GetOperatorOnDuty() : Operator
    + ActivateCooling(amount:double) : double
    + TriggerSafetySystems() : bool
  }
  
  class Operator {
    # name : string
    # clearanceLevel : int
    + AnswerAlarm(alarm:Alarm) : void
    + InitiateScram(reactorCore:ReactorCore) : void
  }
  
  class Alarm {
    - level : AlarmLevel
    # alarmCode : int
    + Trigger(level:AlarmLevel) : void
    + Silence() : void
  }
  
  enum AlarmLevel {
    LOW
    MEDIUM
    HIGH
  }
  
  ' notes '
  note right of ControlRoom
    Sensors are aggregated, because they
    physically belong to Reactor, and
    ControlRoom only reads their measuredValue.
    ControlRoom depends only on ICoolingSystem and
    ISafetySystem, so new systems can be added
    without changing it.
  endnote
}

package cooling {
  interface ICoolingSystem {
    + RemoveHeat(core:ReactorCore, amount:double) : double
  }
  
  class PrimaryLoop {
    - pumps : List<Pump>
    - coolantTemperature : double
    # flowRate : double
    + RemoveHeat(core:ReactorCore, amount:double) : double
  }
  
  class EmergencyCoolingSystem {
    - waterReserveLiters : double
    - pumps : List<Pump>
    # isActive : bool
    + Activate(core:ReactorCore) : bool
    + RemoveHeat(core:ReactorCore, amount:double) : double
  }
  
  class Pump {
    - powerKw : double
    # isRunning : bool
    + Start() : void
    + Stop() : void
    + SetFlowRate(rate:double) : void
  }
  
  class SteamGenerator {
    - secondaryLoop : SecondaryLoop
    # steamPressure : double
    + TransferHeat(primary:PrimaryLoop) : double
  }
  
  class SecondaryLoop {
    # steamTemperature : double
    + GetSteam() : double
  }
  
  ' notes '
  note bottom of Pump
    Pump is different in PrimaryLoop, EmergencyCoolingSystem
    and in Condenser
  endnote
  
  note top of EmergencyCoolingSystem
    EmergencyCoolingSystem is both ICoolingSystem
    and ISafetySystem
  endnote
}

package power {
  class Turbine {
    - condenser : Condenser
    - rotationSpeedRpm : double
    # maxSteamPressure : double
    + Spin(secondaryLoop:SecondaryLoop) : double
  }
  
  class Generator {
    - ratedPowerMw : double
    - turbine : Turbine
    - transformer : Transformer
    + GenerateElectricity() : double
  }
  
  class Transformer {
    - grid : PowerGrid
    - inputVoltageKv : double
    - outputVoltageKv : double
    + ConvertEnergy(powerMw:double) : double
  }
  
  class PowerGrid {
    - demandMw : double
    - currentLoadMw : double
    + GetDemand() : double
    + Receive(powerMw:double) : double
  }
  
  class Condenser {
    - pumps : List<Pump>
    - coolingWaterTemperature : double
    + Condense(steamVolume:double) : double
  }
}

package safety {
  interface ISafetySystem {
    + Activate(core:ReactorCore) : bool
  }
  
  class ScramSystem {
    - responseTimeMs : int
    - isArmed : bool
    + Activate(core:ReactorCore) : bool
    + Arm() : void
  }
  
  class ContainmentBuilding {
    - wallThicknessM : double
    - internalPressure : double
    + GetPressure() : double
    + Activate(core:ReactorCore) : bool
  }
  
  note top of ScramSystem
    Activate calls ReactorCore.Scram automatically,
    while Operator.InitiateScram does the same manually
  end note
}

package waste {
  class RadioactiveWaste {
    - activityBq : double
    - halfLifeYears : double
    + GetRemainingActivity(years:int) : double
  }
  
  class SpentFuelPool {
    - waterTemperature : double
    - capacity : int
    - storedWaste : List<RadioactiveWaste>
    + Store(waste:RadioactiveWaste) : bool
    + GetFreeCapacity() : int
  }
  
  class FuelStorage {
    - capacity : int
    - freshFuel : List<Fuel>
    + Receive(fuel:Fuel) : void
    + Issue(massKg:double) : Fuel
  }
}

' relations in package core
Fuel <|-down- UraniumFuel
Fuel <|-down- MOXFuel
FuelRod -down-> "1" Fuel
ReactorCore o-down- "100..300" FuelRod
ReactorCore o-down- "50..100" ControlRod
ReactorCore ..> RadioactiveWaste
Moderator -down-> ModeratorType
Reactor o-left- "1" Moderator
Reactor *-down- "1" ReactorCore
Reactor -right-> ReactorState
ReactorNote .left. ReactorCore

' relations in package control
Sensor <|-up- TemperatureSensor
Sensor <|-up- PressureSensor
Sensor <|-down- RadiationSensor
Sensor -down-> ReactorCore
ControlRoom o-up- "10..100" Sensor
ControlRoom o-up- "1..*" Operator
ControlRoom o-up- "1" Alarm
ControlRoom -down-> Reactor
ControlRoom o-down- "1..*" ICoolingSystem
ControlRoom o-right- "1..*" ISafetySystem
Operator .up.> Alarm
Operator .[norank].> ReactorCore
Alarm -right-> AlarmLevel

' relations in package cooling
ICoolingSystem <|.down. PrimaryLoop
ICoolingSystem <|.down. EmergencyCoolingSystem
ICoolingSystem .left.> ReactorCore
PrimaryLoop *-down- "2..4" Pump
EmergencyCoolingSystem *-down- "2..4" Pump
SteamGenerator .up.> PrimaryLoop
SteamGenerator -down-> "1" SecondaryLoop

' relations in package power
Turbine .up.> SecondaryLoop
Turbine -right-> Condenser
Generator -up-> Turbine
Generator -right-> Transformer
Transformer -right-> PowerGrid
Condenser *-[norank]- "2..4" Pump

' relations in package safety
ISafetySystem <|.right. ScramSystem
ISafetySystem <|.up. ContainmentBuilding
ISafetySystem <|.down. EmergencyCoolingSystem
ISafetySystem ..> ReactorCore

' relations in package waste
SpentFuelPool o-up- "0..*" RadioactiveWaste
FuelStorage o-[norank]- "0..*" Fuel

' layout (hidden links)
ReactorCore -[hidden]right- PrimaryLoop
ICoolingSystem -[hidden]up- ISafetySystem
FuelStorage -[hidden]right- RadioactiveWaste
MOXFuel .[hidden]down.> RadioactiveWaste

@enduml